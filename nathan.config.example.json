{
  "name": "nathan",
  "hostname": "login.example.com",
  "securityProfile": "business",
  "database": {
    "type": "d1",
    "name": "nathan-auth"
  },
  "providers": {
    "google": {
      "enabled": false
    },
    "github": {
      "enabled": false
    }
  },
  "applications": [
    {
      "id": "website",
      "kind": "external",
      "hostname": "example.com",
      "callbackPath": "/auth/callback",
      "protection": "oidc"
    },
    {
      "id": "dashboard",
      "kind": "worker",
      "workerName": "my-dashboard",
      "hostname": "app.example.com",
      "protection": "gateway"
    }
  ],
  "realm": {
    "apex": "example.com",
    "issuerHostname": "login.example.com",
    "includeApex": true,
    "includeSubdomains": true,
    "registration": "approved-only"
  }
}
