{
  "name": "nathan",
  "hostname": "login.example.com",
  "securityProfile": "standard",
  "database": {
    "type": "d1",
    "name": "nathan-auth"
  },
  "providers": {
    "google": {
      "enabled": false
    },
    "github": {
      "enabled": false
    }
  },
  "applications": [
    {
      "id": "website",
      "kind": "external",
      "hostname": "example.com",
      "callbackPath": "/auth/callback",
      "protection": "oidc"
    },
    {
      "id": "dashboard",
      "kind": "worker",
      "workerName": "my-dashboard",
      "hostname": "app.example.com",
      "protection": "gateway",
      "rbac": {
        "accessMode": "approved",
        "permissions": {
          "invoices:read": "Read invoices",
          "invoices:write": "Create and edit invoices"
        },
        "roles": {
          "viewer": {
            "description": "Read-only access",
            "permissions": [
              "invoices:read"
            ]
          },
          "editor": {
            "description": "Edit invoices",
            "permissions": [
              "invoices:read",
              "invoices:write"
            ]
          }
        }
      }
    }
  ],
  "realm": {
    "apex": "example.com",
    "issuerHostname": "login.example.com",
    "includeApex": true,
    "includeSubdomains": true,
    "registration": "approved-only"
  }
}
