{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nathan-gateway",
  "main": "src/gateway/worker.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "UPSTREAM",
      "service": "REPLACE_WITH_PRIVATE_APPLICATION_WORKER"
    }
  ],
  "d1_databases": [
    {
      "binding": "SESSIONS",
      "database_name": "nathan-gateway",
      "database_id": "REPLACE_WITH_GATEWAY_D1_DATABASE_ID",
      "migrations_dir": "migrations/gateway"
    }
  ],
  "vars": {
    "NATHAN_ISSUER": "https://auth.example.com/api/auth",
    "APPLICATION_ID": "dashboard",
    "OIDC_CLIENT_ID": "REPLACE_WITH_OIDC_CLIENT_ID",
    "SESSION_TTL_SECONDS": "28800",
    "REQUIRE_AAL2": "false"
  },
  "routes": [
    {
      "pattern": "dashboard.example.com",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "0 5 * * *"
    ]
  }
}
