{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nathan-installer",
  "main": "src/installer/worker.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled":true},
  "triggers":{"crons":["13 4 * * *"]},
  "d1_databases":[
    {"binding":"INSTALLER_DB","database_name":"nathan-installer","database_id":"REPLACE_WITH_INSTALLER_D1_DATABASE_ID","migrations_dir":"migrations/installer"}
  ],
  "vars":{
    "PUBLIC_ORIGIN":"https://install.example.com",
    "CF_OAUTH_CLIENT_ID":"REPLACE_WITH_CLOUDFLARE_OAUTH_CLIENT_ID",
    "CF_OAUTH_SCOPES":"user-details.read account-settings.read zone.read workers-scripts.admin workers-routes.write"
  },
  "routes":[{"pattern":"install.example.com","custom_domain":true}]
}
