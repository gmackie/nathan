{
  "name": "nathan-test-embedded",
  "main": "worker.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "library-identity",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "node_modules/@nathan/worker/migrations"
  }],
  "durable_objects": {
    "bindings": [{ "name": "SCIM_DIRECTORY", "class_name": "NathanScimDirectory" }]
  },
  "migrations": [{ "tag": "nathan-scim-v1", "new_sqlite_classes": ["NathanScimDirectory"] }]
}
