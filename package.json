{
  "name": "nathan-blueprint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deployable Cloudflare-native Better Auth identity provider and access gateway",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "init": "node scripts/nathan.mjs init",
    "plan": "node scripts/nathan.mjs plan",
    "doctor": "node scripts/nathan.mjs doctor",
    "deploy": "node scripts/nathan.mjs deploy",
    "schema:generate": "auth generate --config src/auth/schema-config.ts --output migrations/0002_better_auth.sql --yes --adapter kysely",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:auth": "wrangler deploy --config wrangler.auth.jsonc --dry-run --outdir .nathan/build-auth",
    "build:gateway": "wrangler deploy --config wrangler.gateway.jsonc --dry-run --outdir .nathan/build-gateway",
    "schema:check": "auth check --config src/auth/schema-config.ts",
    "providers": "node scripts/nathan.mjs providers",
    "protect": "node scripts/nathan.mjs protect",
    "build:installer": "wrangler deploy --config wrangler.installer.jsonc --dry-run --outdir .nathan/build-installer",
    "pack:release": "node scripts/pack-release.mjs",
    "deploy:installer": "node scripts/setup-installer.mjs",
    "wizard": "node scripts/nathan.mjs wizard",
    "setup:installer": "node scripts/setup-installer.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.14",
    "@better-auth/oauth-provider": "1.7.14",
    "@better-auth/passkey": "1.7.14",
    "@better-auth/sso": "1.7.14",
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0",
    "auth": "1.7.14",
    "@types/node": "^22.0.0"
  },
  "overrides": {
    "@better-auth/core": "1.7.14",
    "@better-fetch/fetch": "1.3.3"
  }
}
