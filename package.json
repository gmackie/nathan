{
  "name": "nathan-blueprint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deployable Cloudflare-native Better Auth identity provider and access gateway",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "verify:site": "node scripts/verify-site.mjs",
    "init": "node scripts/nathan.mjs init",
    "plan": "node scripts/nathan.mjs plan",
    "doctor": "node scripts/nathan.mjs doctor",
    "deploy": "node scripts/nathan.mjs deploy",
    "schema:generate": "auth generate --config src/auth/schema-config.ts --output migrations/0002_better_auth.sql --yes --adapter kysely",
    "test": "node scripts/build-ui.mjs && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build:ui": "node scripts/build-ui.mjs",
    "build:auth": "node scripts/build-ui.mjs && wrangler deploy --config wrangler.auth.jsonc --dry-run --outdir .nathan/build-auth",
    "build:gateway": "node scripts/build-ui.mjs && wrangler deploy --config wrangler.gateway.jsonc --dry-run --outdir .nathan/build-gateway",
    "schema:check": "auth check --config src/auth/schema-config.ts",
    "providers": "node scripts/nathan.mjs providers",
    "protect": "node scripts/nathan.mjs protect",
    "build:installer": "node scripts/build-ui.mjs && wrangler deploy --config wrangler.installer.jsonc --dry-run --outdir .nathan/build-installer",
    "pack:release": "node scripts/pack-release.mjs",
    "deploy:installer": "node scripts/setup-installer.mjs",
    "wizard": "node scripts/nathan.mjs wizard",
    "setup:installer": "node scripts/setup-installer.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "build:test-upstream": "node tests/runtime/fixtures/build-upstream.mjs",
    "build:test-mcp": "node tests/runtime/fixtures/build-mcp.mjs",
    "build:test-ui": "node tests/runtime/fixtures/build-ui-worker.mjs",
    "test:runtime": "npm run build:auth && npm run build:gateway && npm run build:installer && npm run build:test-upstream && npm run build:test-mcp && npm run build:test-ui && node --test --test-concurrency=1 tests/runtime/*.test.mjs"
  },
  "dependencies": {
    "@better-auth/core": "1.7.14",
    "@better-auth/oauth-provider": "1.7.14",
    "@better-auth/passkey": "1.7.14",
    "@better-auth/sso": "1.7.14",
    "@cloudflare/kumo": "2.19.0",
    "@phosphor-icons/react": "2.1.10",
    "@xmldom/xmldom": "^0.9.12",
    "better-auth": "1.7.14",
    "jose": "^6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uqr": "0.1.3",
    "xml-crypto": "^6.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@better-auth/utils": "0.5.1",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "^22.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "auth": "1.7.14",
    "esbuild": "0.28.2",
    "fast-xml-parser": "5.11.2",
    "miniflare": "5.20261118.0-beta",
    "samlify": "2.15.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.165.0"
  },
  "overrides": {
    "@better-auth/core": "1.7.14",
    "@better-fetch/fetch": "1.3.3"
  }
}
