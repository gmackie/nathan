{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nathan-auth",
  "main": "src/auth/worker.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nathan-auth",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "NATHAN_ISSUER": "https://auth.example.com",
    "NATHAN_ADMIN_EMAILS": "",
    "NATHAN_SECURITY_PROFILE": "business",
    "NATHAN_BOOTSTRAP_REQUIRED": "true",
    "NATHAN_INSTALL_ACTIVE": "true",
    "NATHAN_MCP_WRITE_ENABLED": "false",
    "NATHAN_REALM_APEX": "",
    "ENABLE_PASSWORD": "false",
    "ENTERPRISE_SSO": "false",
    "NATHAN_ADMIN_STEPUP_REQUIRED": "true"
  },
  "routes": [
    {
      "pattern": "auth.example.com",
      "custom_domain": true
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SCIM_DIRECTORY",
        "class_name": "NathanScimDirectory"
      }
    ]
  },
  // NATH-37: hashed UI assets (scripts/build-ui.mjs). Every file sits under /__nathan/ui/, so no
  // asset can shadow a Worker route; requests for anything else still reach the Worker.
  // _headers sets immutable caching, nosniff and CORP same-origin on them.
  "assets": {
    "directory": ".nathan/ui-assets",
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "migrations": [
    {
      "tag": "nathan-scim-v1",
      "new_sqlite_classes": [
        "NathanScimDirectory"
      ]
    }
  ]
}
