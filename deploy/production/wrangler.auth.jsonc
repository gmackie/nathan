// The production gmacko identity Worker at id.gmac.io (NATH-31), deployed through ForgeGraph (app "nathan",
// stage "production"). Not a template for customer installs: use the CLI wizard or the
// hosted installer. Secrets (BETTER_AUTH_SECRET, NATHAN_CONFIG_KEY,
// NATHAN_ADMIN_EMAILS, provider credentials) come from ForgeGraph's production secret
// store and are uploaded with the Worker; none are written here.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "nathan-prod-auth",
  "main": "../../src/auth/worker.ts",
  // NATH-32: build the hashed Kumo UI assets the Worker bundles (src/ui/assets.ts). Wrangler runs
  // this from the directory it is invoked in (the repository root), not this config's directory.
  "build": { "command": "node scripts/build-ui.mjs" },
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nathan-prod-auth",
      "database_id": "5dde28ff-338c-475c-a72d-e775eb594a1b",
      "migrations_dir": "../../migrations"
    }
  ],
  "vars": {
    "NATHAN_ISSUER": "https://id.gmac.io",
    "NATHAN_SECURITY_PROFILE": "business",
    "NATHAN_BOOTSTRAP_REQUIRED": "true",
    "NATHAN_INSTALL_ACTIVE": "true",
    "NATHAN_MCP_WRITE_ENABLED": "false",
    "NATHAN_REALM_APEX": "",
    "ENABLE_PASSWORD": "false",
    "ENABLE_EMAIL_OTP": "false",
    "ENTERPRISE_SSO": "true",
    "NATHAN_ADMIN_STEPUP_REQUIRED": "true",
    "NATHAN_INSTANCE_NAME": "gmacko"
  },
  "routes": [{ "pattern": "id.gmac.io", "custom_domain": true }],
  "triggers": { "crons": ["17 5 * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "SCIM_DIRECTORY", "class_name": "NathanScimDirectory" }]
  },
  "migrations": [{ "tag": "nathan-scim-v1", "new_sqlite_classes": ["NathanScimDirectory"] }]
}
